#!/usr/bin/env zsh
typeset -g ROOT="${0:A:h}"
export PATH="/opt/homebrew/bin:$PATH"
export LC_ALL="${LC_ALL:-en_US.UTF-8}"

source "$ROOT/engine/report.zsh"
source "$ROOT/engine/core.zsh"
source "$ROOT/engine/graph.zsh"
source "$ROOT/engine/ledger.zsh"
source "$ROOT/engine/applock.zsh"
source "$ROOT/engine/secrets.zsh"
source "$ROOT/engine/cmd.zsh"
for _p in "$ROOT"/providers/*.zsh(N); do source "$_p"; done

usage() {
    cat <<'EOF'
usage: mac <command> [unit...] [-v]

  check [unit...]     plan only — pure, offline, changes nothing
  sync  [unit...]     converge the machine to the repo
  up    [app...]      move external apps forward, as an apps.lock diff
  restart             activation pass alone
  reload              re-read live configs (aerospace, kitty, karabiner)

  tree | list         the dependency graph · units and counts
  explain <name>      everything known about a resource
  scan | adopt <App>  find unmanaged apps · write a declaration for one
  capture <domain>    learn a defaults declaration from the machine
  lint                units must stay declarations only
  secret <add|get|list|rotate>   private values, encrypted in the repo
  prune | forget      revert what left the repo · drop ownership
  ack <step>          retire a done manual step
  log                 last run's journal
  do [task]           one-shot tasks · no name lists them
  vpn [command]       the tunnel · no name lists them
EOF
}

state_init
ledger_load
load_units

typeset -a ARGV
typeset -g CMD=''
for _a in "$@"; do
    case "$_a" in
        -v|--verbose) VERBOSE=1 ;;
        -y|--yes)     ASSUME_YES=1 ;;
        -h|--help)    usage; exit 0 ;;
        -*)           die "unknown flag: $_a" ;;
        *)            if [[ -z "$CMD" ]]; then CMD=$_a; else ARGV+=("$_a"); fi ;;
    esac
done
: ${CMD:=check}

case "$CMD" in
    check)   cmd_check   "${ARGV[@]}" ;;
    sync)    cmd_sync    "${ARGV[@]}" ;;
    tree)    cmd_tree    "${ARGV[@]}" ;;
    list)    cmd_list    "${ARGV[@]}" ;;
    explain) cmd_explain "${ARGV[@]}" ;;
    secret)  cmd_secret  "${ARGV[@]}" ;;
    log)     cmd_log     "${ARGV[@]}" ;;
    up)      cmd_up      "${ARGV[@]}" ;;
    prune)   cmd_prune   "${ARGV[@]}" ;;
    forget)  cmd_forget  "${ARGV[@]}" ;;
    ack)     cmd_ack     "${ARGV[@]}" ;;
    restart) cmd_restart ;;
    reload)  cmd_reload ;;
    scan)    cmd_scan    "${ARGV[@]}" ;;
    adopt)   cmd_adopt   "${ARGV[@]}" ;;
    capture) cmd_capture "${ARGV[@]}" ;;
    lint)    cmd_lint    "${ARGV[@]}" ;;
    do)      cmd_do      "${ARGV[@]}" ;;
    help)    usage ;;
    *)       if [[ -n "$CMD" && -d "$ROOT/private/$CMD/tasks" ]]; then
                 cmd_tree "$CMD" "${ARGV[@]}"
             else
                 die "unknown command '$CMD' — try: mac help"
             fi ;;
esac

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.mac-setup.desk-rescue</string>
    <!-- Independent of the agent: if the agent hangs, this still lights a dark panel that has no
         monitor to stand in for it, within five seconds. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Applications/Desk.app/Contents/MacOS/Desk</string>
        <string>rescue</string>
    </array>
    <key>RunAtLoad</key><true/>
    <key>StartInterval</key><integer>5</integer>
    <key>ProcessType</key><string>Interactive</string>
</dict>
</plist>

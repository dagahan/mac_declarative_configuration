{
    "global": {
        "show_in_menu_bar": false
    },
    "profiles": [
        {
            "name": "mac_setup",
            "selected": true,
            "virtual_hid_keyboard": { "keyboard_type_v2": "ansi" },
            "complex_modifications": {
                "rules": [
                    {
                        "description": "InputLock: Right Shift + Delete locks all input, and unlocks it again (first, so it wins over everything below)",
                        "manipulators": [
                            {
                                "type": "basic",
                                "from": {
                                    "key_code": "delete_or_backspace",
                                    "modifiers": { "mandatory": ["right_shift"], "optional": ["caps_lock"] }
                                },
                                "conditions": [{ "type": "variable_unless", "name": "inputlock_locked", "value": 1 }],
                                "to": [
                                    { "set_variable": { "name": "inputlock_locked", "value": 1 } },
                                    { "shell_command": "/Applications/InputLock.app/Contents/MacOS/InputLock lock" }
                                ]
                            },
                            {
                                "type": "basic",
                                "from": {
                                    "key_code": "delete_or_backspace",
                                    "modifiers": { "mandatory": ["right_shift"], "optional": ["caps_lock"] }
                                },
                                "conditions": [{ "type": "variable_if", "name": "inputlock_locked", "value": 1 }],
                                "to": [
                                    { "set_variable": { "name": "inputlock_locked", "value": 0 } },
                                    { "shell_command": "/Applications/InputLock.app/Contents/MacOS/InputLock unlock" }
                                ]
                            }
                        ]
                    },
                    {
                        "description": "InputLock: while locked, every key, media key and mouse button does nothing (right_shift still registers so the unlock can match)",
                        "manipulators": [
                            {
                                "type": "basic",
                                "from": { "key_code": "right_shift", "modifiers": { "optional": ["any"] } },
                                "conditions": [{ "type": "variable_if", "name": "inputlock_locked", "value": 1 }],
                                "to": [{ "key_code": "right_shift" }]
                            },
                            {
                                "type": "basic",
                                "from": { "any": "key_code", "modifiers": { "optional": ["any"] } },
                                "conditions": [{ "type": "variable_if", "name": "inputlock_locked", "value": 1 }],
                                "to": []
                            },
                            {
                                "type": "basic",
                                "from": { "any": "consumer_key_code", "modifiers": { "optional": ["any"] } },
                                "conditions": [{ "type": "variable_if", "name": "inputlock_locked", "value": 1 }],
                                "to": []
                            },
                            {
                                "type": "basic",
                                "from": { "any": "pointing_button", "modifiers": { "optional": ["any"] } },
                                "conditions": [{ "type": "variable_if", "name": "inputlock_locked", "value": 1 }],
                                "to": []
                            }
                        ]
                    },
                    {
                        "description": "Desk: Ctrl+Option+Cmd+L turns the laptop panel on or off until a monitor cable changes (works even when the Desk agent is not running)",
                        "manipulators": [
                            {
                                "type": "basic",
                                "from": {
                                    "key_code": "l",
                                    "modifiers": { "mandatory": ["control", "option", "command"], "optional": ["caps_lock"] }
                                },
                                "to": [{ "shell_command": "/Applications/Desk.app/Contents/MacOS/Desk toggle" }]
                            }
                        ]
                    },
                    {
                        "description": "Disable Cmd+Q and Cmd+W (Cmd+Shift+Q still works)",
                        "manipulators": [
                            {
                                "type": "basic",
                                "from": { "key_code": "q", "modifiers": { "mandatory": ["command"], "optional": ["caps_lock"] } },
                                "to": []
                            },
                            {
                                "type": "basic",
                                "from": { "key_code": "w", "modifiers": { "mandatory": ["command"], "optional": ["caps_lock"] } },
                                "to": []
                            }
                        ]
                    },
                    {
                        "description": "Cmd+Space -> Ainto launcher (intercepted before Spotlight; emits Ainto's Cmd+Shift+Space hotkey)",
                        "manipulators": [
                            {
                                "type": "basic",
                                "from": {
                                    "key_code": "spacebar",
                                    "modifiers": { "mandatory": ["command"], "optional": ["caps_lock"] }
                                },
                                "to": [
                                    { "key_code": "spacebar", "modifiers": ["left_command", "left_shift"] }
                                ]
                            }
                        ]
                    },
                    {
                        "description": "F3 (plain press, no fn/modifiers) -> AeroSpace mission-control overlay",
                        "manipulators": [
                            {
                                "type": "basic",
                                "from": {
                                    "key_code": "f3",
                                    "modifiers": { "optional": ["caps_lock"] }
                                },
                                "to": [{ "shell_command": "/opt/homebrew/bin/aerospace mission-control" }]
                            },
                            {
                                "type": "basic",
                                "from": {
                                    "key_code": "mission_control",
                                    "modifiers": { "optional": ["caps_lock", "fn"] }
                                },
                                "to": [{ "shell_command": "/opt/homebrew/bin/aerospace mission-control" }]
                            }
                        ]
                    }
                ]
            }
        }
    ]
}

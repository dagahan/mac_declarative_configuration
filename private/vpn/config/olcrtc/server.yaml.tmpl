# Generated by mac_setup — edit the template, not this file.
mode: srv

# Carrier. jitsi+datachannel is the fast path and needs no registration.
# To move to the whitelist-grade carrier, swap this block for the wbstream one
# below and set the room:  mac secret add olcrtc-room
auth:
  provider: jitsi
room:
  id: "https://meet.egovm.ru/{{olcrtc-room}}"
net:
  transport: datachannel
  dns: "1.1.1.1:53"

# --- whitelist-grade alternative (Mishanya's settings) -----------------
# auth:
#   provider: wbstream
# room:
#   id: "{{olcrtc-room}}"
# net:
#   transport: vp8channel
#   dns: "1.1.1.1:53"
# vp8:
#   fps: 24
#   batch_size: 24
# -----------------------------------------------------------------------

crypto:
  key: "{{olcrtc-key}}"

liveness:
  interval: 10s
  timeout: 5s
  failures: 3


data: /usr/local/share/olcrtc/data
